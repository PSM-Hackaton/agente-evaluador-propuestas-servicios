# =============================================================================
# Agente Evaluador de Propuestas de Servicios — Backend Configuration
# =============================================================================

APP_NAME="Agente Evaluador de Propuestas de Servicios"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS="https://localhost:5173,http://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173,http://localhost:5174,http://localhost:4173,https://localhost:3000,http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL requerido vía postgresql+asyncpg://)
# La contraseña no se escribe en la URL: defínala en la variable estándar PGPASSWORD (o en ~/.pgpass).
DATABASE_URL="postgresql+asyncpg://postgres@127.0.0.1:5432/evaluador_propuestas"
# Ejemplo PostgreSQL remoto / Supabase con TLS 1.2+ (contraseña en PGPASSWORD):
# DATABASE_URL="postgresql+asyncpg://postgres.<PROYECTO>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DB_SSL_MODE="prefer"
DB_SSL_CA_FILE=""
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_AUTO_CREATE_TABLES=false

# Storage directory (all files stored here are encrypted at rest with AES-256-GCM)
STORAGE_DIR="./data/storage"

# =============================================================================
# Security: AES-256-GCM Encryption at Rest & JWT Auth & TLS 1.2/1.3 in Transit
# =============================================================================
# 32-byte URL-safe base64 key (generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
MASTER_ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_BYTE_BASE64_KEY_FOR_PRODUCTION"
PREVIOUS_ENCRYPTION_KEY=""
JWT_SECRET_KEY="CHANGE_ME_GENERATE_STRONG_JWT_SECRET_FOR_PRODUCTION"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# TLS 1.2/1.3 (run scripts/generate_tls_certs.sh for local development certs)
TLS_ENABLED=true
TLS_CERT_FILE="./certs/server.crt"
TLS_KEY_FILE="./certs/server.key"

# =============================================================================
# Local AI Provider Configuration (Multimodal + Tool Calling, zero external keys)
# =============================================================================
# Recommended for hackathon demo: local Ollama / llama.cpp OpenAI-compatible API
# Modelo unificado (texto + tools + visión en un solo modelo para equipos con RAM limitada):
#   podman run -d --name evaluador-ollama -p 127.0.0.1:11434:11434 -v evaluador-ollama-models:/root/.ollama docker.io/ollama/ollama:latest
#   podman exec evaluador-ollama ollama pull qwen3.5:4b
LLM_PROVIDER="openai"
LLM_TIMEOUT_SECONDS=120
LLM_DISABLE_THINKING=true
LLM_LOCAL_MAX_TOKENS=650
LLM_LOCAL_VISION_MAX_TOKENS=900
OPENAI_BASE_URL="http://127.0.0.1:11434/v1"
OPENAI_API_KEY="local"
OPENAI_MODEL="qwen3.5:4b"
OPENAI_VISION_MODEL="qwen3.5:4b"

# Registro público sin invitación (rol cargador, con lectura de todos los proyectos).
# false por defecto: las cuentas se crean con códigos de invitación del administrador.
PUBLIC_SIGNUP_ENABLED=false

# =============================================================================
# Market Price Web Search & BCV Exchange Rate
# =============================================================================
WEB_SEARCH_ENABLED=true
BCV_FALLBACK_RATE=52.50
DEFAULT_IVA_RATE=0.16
ABUSIVE_SURCHARGE_PCT_THRESHOLD=50.0
MAX_UPLOAD_SIZE_MB=25

# =============================================================================
# Hackathon Batch Mode Metadata (salida.json)
# =============================================================================
# Path of the repository in the event GitLab (field "repositorio" of salida.json)
HACKATHON_REPO_PATH="grupo/chuao/chuao_grupo4/propuesta_servicios"
TIMEZONE_OFFSET="-04:00"
