# false = consume la API real de FastAPI (valor por defecto)
# true  = modo demostración con datos simulados en el navegador (no necesita backend)
VITE_USE_MOCK=false

# Prefijo de la API del backend FastAPI (API_V1_PREFIX). Con el proxy de Vite basta con /api/v1
VITE_API_URL=/api/v1

# Destino del proxy de Vite en desarrollo (solo para `npm run dev`)
BACKEND_URL=https://localhost:8000

# HTTPS opcional en `npm run dev` (TLS 1.2+). Rutas a certificado y clave locales, fuera del repositorio.
# VITE_TLS_CERT=
# VITE_TLS_KEY=
