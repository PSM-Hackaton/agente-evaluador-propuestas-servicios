# true  = usa datos simulados en el navegador (no necesita backend)
# false = consume la API real de FastAPI
VITE_USE_MOCK=true

# Prefijo de la API. Con el proxy de Vite basta con /api
VITE_API_URL=/api

# Destino del proxy de Vite en desarrollo (solo para `npm run dev`)
BACKEND_URL=http://localhost:8000
